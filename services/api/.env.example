DATABASE_URL=postgres://atelier:atelier_local_only@127.0.0.1:5432/atelier
# DEV_AUTH=true is localhost development only. Never enable on public deployment.
DEV_AUTH=true
# If disabled, no way to log in until Google OIDC is implemented.
BIND_ADDRESS=127.0.0.1:8080
RUST_LOG=atelier_api=debug,tower_http=info

# Base64 32-byte encryption key; inject on the server, never expose via VITE_.
# scripts/start-dev-api.ps1 manages an ignored development key automatically.
# ATELIER_CREDENTIAL_KEY=
WEB_ORIGIN=http://127.0.0.1:5173
